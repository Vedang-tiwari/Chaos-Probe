# ==============================================================================
# Chaos Probe Environment Configuration
# ==============================================================================

# General
APP_NAME=Chaos Probe
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security / Admin
ADMIN_API_KEY=chaos-probe-admin-secret-key-change-in-production

# Database (PostgreSQL)
# For local development or testing without Postgres running, SQLite fallback is supported when configured
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chaos_probe
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Safety Controls
MAX_EXPERIMENT_DURATION_SECONDS=120
DEFAULT_BASELINE_DURATION_SECONDS=30
ALLOW_HOST_NETWORK_INJECTION=False
DEFAULT_MAX_CPU_PERCENT=90.0
DEFAULT_MAX_MEMORY_PERCENT=90.0
DEFAULT_MAX_ERROR_RATE=0.25
DEFAULT_MAX_LATENCY_MS=3000.0

# Monitoring / Prometheus / Telemetry
PROMETHEUS_METRICS_ENABLED=True
PROMETHEUS_PORT=9090
OTEL_SERVICE_NAME=chaos-probe
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_TELEMETRY=False

# Docker Engine Adapter
DOCKER_HOST_URL=
DOCKER_TIMEOUT_SECONDS=60
