{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Chaos Probe Live Platform Telemetry",
      "type": "row"
    },
    {
      "id": 2,
      "title": "Active Running Experiments",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "chaos_probe_experiments_running",
          "legendFormat": "Running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Target Service Availability",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "chaos_probe_service_availability",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Active Fault Injections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(chaos_probe_active_faults) by (fault_type)",
          "legendFormat": "{{fault_type}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rollback Failures Total",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(chaos_probe_rollback_failures_total)",
          "legendFormat": "Rollback Failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Observed Request Latency by Phase (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "rate(chaos_probe_request_latency_seconds_sum[1m]) / rate(chaos_probe_request_latency_seconds_count[1m])",
          "legendFormat": "{{service}} [{{phase}}]"
        }
      ]
    },
    {
      "id": 7,
      "title": "Observed Error Rate by Phase",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "rate(chaos_probe_request_errors_total[1m])",
          "legendFormat": "{{service}} - {{phase}} errors/s"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["chaos-probe", "resilience", "microservices"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Chaos Probe - Platform & Resilience Overview",
  "uid": "chaos-probe-overview",
  "version": 1
